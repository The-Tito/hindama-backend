# Copia este archivo a .env y cambia cada valor. .env nunca se sube al repositorio.
# Genera contraseñas con: python -c "import secrets; print(secrets.token_urlsafe(24))"

# ---- PostgreSQL local (solo Docker Compose) ----
POSTGRES_PASSWORD=cambia-esto
HINDAMA_MIGRATIONS_DB_PASSWORD=cambia-esto
HINDAMA_API_DB_PASSWORD=cambia-esto
HINDAMA_SCANNER_DB_PASSWORD=cambia-esto
HINDAMA_BACKUP_DB_PASSWORD=cambia-esto

# ---- API ----
HINDAMA_ENVIRONMENT=development
HINDAMA_LOG_LEVEL=INFO
# json para producción; console es más legible en local.
HINDAMA_LOG_FORMAT=console

# ---- Amazon Cognito (User Pool de desarrollo) ----
# No son secretos: la API solo valida tokens con las llaves públicas del User Pool.
HINDAMA_COGNITO_REGION=us-east-1
HINDAMA_COGNITO_USER_POOL_ID=us-east-1_cambiaEsto
HINDAMA_COGNITO_CLIENT_ID=cambiaesto
