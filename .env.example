# Copia este archivo a .env y cambia cada valor. .env nunca se sube al repositorio.
# Genera contraseñas con: python -c "import secrets; print(secrets.token_urlsafe(24))"

# ---- PostgreSQL local (solo Docker Compose) ----
POSTGRES_PASSWORD=cambia-esto
HINDAMA_MIGRATIONS_DB_PASSWORD=cambia-esto
HINDAMA_API_DB_PASSWORD=cambia-esto
HINDAMA_SCANNER_DB_PASSWORD=cambia-esto
HINDAMA_BACKUP_DB_PASSWORD=cambia-esto

# ---- Redis: cola de ejecuciones (ADR-012) ----
# Solo Docker Compose. La API y el motor arman su URL con esta contraseña.
HINDAMA_REDIS_PASSWORD=cambia-esto

# ---- API ----
HINDAMA_ENVIRONMENT=development
HINDAMA_LOG_LEVEL=INFO
# json para producción; console es más legible en local.
HINDAMA_LOG_FORMAT=console

# ---- Amazon Cognito (User Pool de desarrollo) ----
# No son secretos: la API solo valida tokens con las llaves públicas del User Pool.
HINDAMA_COGNITO_REGION=us-east-1
HINDAMA_COGNITO_USER_POOL_ID=us-east-1_cambiaEsto
HINDAMA_COGNITO_CLIENT_ID=cambiaesto

# ---- Términos de uso responsable (RF-16, RN-12) ----
# Versión vigente (AAAA-MM-DD). Al cambiarla, todos los usuarios deben aceptarlos de nuevo.
HINDAMA_TERMS_VERSION=2026-10-30

# ---- Guardia de destinos (RF-11, ADR-008) ----
# IP públicas propias de Hindama (IP elásticas del frontend y del backend), en JSON. Nadie puede
# apuntar la plataforma contra sí misma. En local se deja vacía.
HINDAMA_OWN_IP_ADDRESSES=[]

# ---- Credenciales de las identidades de prueba (ADR-007, RN-11) ----
# Llaves maestras AES-256 por versión, en base64 y en JSON. En producción vienen de SSM Parameter
# Store. Genera una con: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Para rotar: agrega la versión 2, cambia HINDAMA_CREDENTIAL_KEY_VERSION a 2, vuelve a cifrar las
# filas y después retira la versión 1. Perder la llave deja ilegibles las credenciales guardadas.
HINDAMA_CREDENTIAL_KEYS={"1":"cambia-esto-por-32-bytes-en-base64"}
HINDAMA_CREDENTIAL_KEY_VERSION=1
