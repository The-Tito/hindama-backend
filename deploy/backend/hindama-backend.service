# Starts the backend at every boot (RNF-20): secrets from SSM, then Docker Compose.
# Installed by bootstrap.sh in /etc/systemd/system/.
[Unit]
Description=Hindama backend (Docker Compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hindama
ExecStartPre=/opt/hindama/load-env.sh
ExecStart=/usr/bin/docker compose --env-file /run/hindama/backend.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /run/hindama/backend.env stop
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
